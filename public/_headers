# Cloudflare Pages headers. Pages serves pretty URLs (/about, not /about.html),
# so rules match those paths.

/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: camera=(), microphone=(), geolocation=(), payment=(), usb=()
  X-Frame-Options: DENY
  Strict-Transport-Security: max-age=31536000
  Content-Security-Policy: default-src 'self'; script-src 'self' 'unsafe-inline' https://www.googletagmanager.com; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob: https://*.google-analytics.com https://*.googletagmanager.com; font-src 'self'; connect-src 'self' https://formspree.io https://*.google-analytics.com https://*.analytics.google.com https://*.googletagmanager.com; form-action 'self' https://formspree.io; frame-ancestors 'none'; base-uri 'self'; object-src 'none'

# Hashed build assets never change.
/_next/static/*
  Cache-Control: public, max-age=31536000, immutable

# Unhashed images: cache for a week, revalidate after.
/logos/*
  Cache-Control: public, max-age=604800, stale-while-revalidate=86400
/og-default.png
  Cache-Control: public, max-age=604800, stale-while-revalidate=86400
/icon-512.png
  Cache-Control: public, max-age=604800, stale-while-revalidate=86400
/uploads/*
  Cache-Control: public, max-age=604800, stale-while-revalidate=86400

# CMS admin. Cloudflare Access guards the login; these headers keep it out of
# search results and lift the site CSP, which would block the CMS script and
# its calls to GitHub.
/admin
  ! Content-Security-Policy
  X-Robots-Tag: noindex, nofollow
  Cache-Control: no-store
/admin/*
  ! Content-Security-Policy
  X-Robots-Tag: noindex, nofollow
  Cache-Control: no-store

# React Server Component payloads (/about.txt etc.) are for client navigation,
# not for search results.
/*.txt
  X-Robots-Tag: noindex
/robots.txt
  ! X-Robots-Tag
